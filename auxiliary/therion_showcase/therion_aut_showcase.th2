encoding utf-8
##XTHERION## xth_me_area_adjust -100.0 -100.0 1900.0 2100.0
##XTHERION## xth_me_area_zoom_to 50

# Symbols directly defined or aliased by the AUT set.
scrap therion_aut_showcase -scale [0 0 1000 0 0 0 40.64 0 m]
  line wall -reverse on
    -50 2000
    1800 2000
    1800 -200
    -50 -200
    -50 2000
  endline

  point 0 0 air-draught
  point 120 0 blocks
  point 240 0 breakdown-choke
  point 360 0 clay
  point 480 0 clay-choke
  point 600 0 clay-tree
  point 720 0 crystal
  point 840 0 debris
  point 960 0 entrance
  point 1080 0 gradient
  point 1200 0 ice
  point 1320 0 ice-pillar
  point 1440 0 ice-stalactite

  point 0 120 ice-stalagmite
  point 120 120 pebbles
  point 240 120 pillar
  point 360 120 sand
  point 480 120 sink
  point 600 120 spring
  point 720 120 stalactite
  point 840 120 stalagmite
  point 960 120 station:fixed
  point 1080 120 station:painted
  point 1200 120 station:temporary
  point 1320 120 water

  line ceiling-meander
    0 400
    200 380
    400 420
    600 400
  endline

  line wall:blocks -outline none
    800 400
    1000 380
    1200 420
    1400 400
  endline

  line ceiling-step
    0 500
    200 480
    400 520
    600 500
  endline

  line wall:clay -outline none
    800 500
    1000 480
    1200 520
    1400 500
  endline

  line contour
    0 600
    200 580
    400 620
    600 600
  endline

  line wall:debris -outline none
    800 600
    1000 580
    1200 620
    1400 600
  endline

  line floor-step
    0 700
    200 680
    400 720
    600 700
  endline

  line wall:flowstone -outline none
    800 700
    1000 680
    1200 720
    1400 700
  endline

  line flowstone
    0 800
    200 780
    400 820
    600 800
  endline

  line wall:ice -outline none
    800 800
    1000 780
    1200 820
    1400 800
  endline

  line overhang
    0 900
    200 880
    400 920
    600 900
  endline

  line wall:moonmilk -outline none
    800 900
    1000 880
    1200 920
    1400 900
  endline

  line pit
    0 1000
    200 980
    400 1020
    600 1000
  endline

  line wall:overlying -outline none
    800 1000
    1000 980
    1200 1020
    1400 1000
  endline

  line survey:cave
    0 1100
    200 1080
    400 1120
    600 1100
  endline

  line wall:pebbles -outline none
    800 1100
    1000 1080
    1200 1120
    1400 1100
  endline

  line wall:pit -outline none
    800 1200
    1000 1180
    1200 1220
    1400 1200
  endline

  line wall:sand -outline none
    800 1300
    1000 1280
    1200 1320
    1400 1300
  endline

  line wall:underlying -outline none
    800 1400
    1000 1380
    1200 1420
    1400 1400
  endline

  area blocks
    l-aut-blocks
  endarea
  line border -id l-aut-blocks -close on -visibility off
    0 1600
    140 1600
    140 1740
    0 1740
    0 1600
  endline

  area clay
    l-aut-clay
  endarea
  line border -id l-aut-clay -close on -visibility off
    170 1600
    310 1600
    310 1740
    170 1740
    170 1600
  endline

  area debris
    l-aut-debris
  endarea
  line border -id l-aut-debris -close on -visibility off
    340 1600
    480 1600
    480 1740
    340 1740
    340 1600
  endline

  area flowstone
    l-aut-flowstone
  endarea
  line border -id l-aut-flowstone -close on -visibility off
    510 1600
    650 1600
    650 1740
    510 1740
    510 1600
  endline

  area ice
    l-aut-ice
  endarea
  line border -id l-aut-ice -close on -visibility off
    680 1600
    820 1600
    820 1740
    680 1740
    680 1600
  endline

  area pebbles
    l-aut-pebbles
  endarea
  line border -id l-aut-pebbles -close on -visibility off
    850 1600
    990 1600
    990 1740
    850 1740
    850 1600
  endline

  area sand
    l-aut-sand
  endarea
  line border -id l-aut-sand -close on -visibility off
    1020 1600
    1160 1600
    1160 1740
    1020 1740
    1020 1600
  endline

  area snow
    l-aut-snow
  endarea
  line border -id l-aut-snow -close on -visibility off
    1190 1600
    1330 1600
    1330 1740
    1190 1740
    1190 1600
  endline

  area sump
    l-aut-sump
  endarea
  line border -id l-aut-sump -close on -visibility off
    1360 1600
    1500 1600
    1500 1740
    1360 1740
    1360 1600
  endline

  area water
    l-aut-water
  endarea
  line border -id l-aut-water -close on -visibility off
    1530 1600
    1670 1600
    1670 1740
    1530 1740
    1530 1600
  endline
endscrap
