encoding utf-8
##XTHERION## xth_me_area_adjust -100.0 -100.0 1900.0 2500.0
##XTHERION## xth_me_area_zoom_to 50

# Symbols directly defined or aliased by the SKBB set.
scrap therion_skbb_showcase -scale [0 0 1000 0 0 0 40.64 0 m]
  line wall -reverse on
    -50 2400
    1800 2400
    1800 -200
    -50 -200
    -50 2400
  endline

  point 0 0 anchor
  point 120 0 borehole
  point 240 0 bridge
  point 360 0 camp
  point 480 0 cave-pearl
  point 600 0 clay
  point 720 0 fixed-ladder
  point 840 0 gradient
  point 960 0 handrail
  point 1080 0 no-equipment
  point 1200 0 rope

  point 0 120 rope-ladder
  point 120 120 sink
  point 240 120 snow
  point 360 120 spring
  point 480 120 station
  point 600 120 station:painted
  point 720 120 station:temporary
  point 840 120 steps
  point 960 120 traverse
  point 1080 120 via-ferrata

  line arrow
    0 400
    200 380
    400 420
    600 400
  endline

  line border:presumed
    800 400
    1000 380
    1200 420
    1400 400
  endline

